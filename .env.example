# ─────────────────────────────────────────────────────────────
# Orchy's keys. Start Orchy copies this file to .env the first time it runs.
# .env is git-ignored. Never commit it or paste these into chat.
# Everything here is optional: Orchy starts without any of it, and the
# dashboard's setup guide shows what each key unlocks.
# ─────────────────────────────────────────────────────────────

# Jev routes every instruction to the right workspace, agent and model. npm run setup asks.
# JEV_PROVIDER picks one: typesafe, openrouter, vercel, opencode, or off. Left empty: the first key set below.
JEV_PROVIDER=
# TypeSafe (https://typesafe.ai): the native Jev.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# OpenRouter (https://openrouter.ai/keys): Jev as ~typesafe/jev-latest, answered as a chat model.
OPENROUTER_API_KEY=
# Vercel AI Gateway (https://vercel.com/ai-gateway): the native Jev, as typesafe-ai/jev.
AI_GATEWAY_API_KEY=
# OpenCode Zen (https://opencode.ai/zen): Jev as jev-1.13, answered as a chat model.
# (OpenCode's free tier only works inside the OpenCode app, so a paid key is needed here.)
OPENCODE_API_KEY=
# OPENCODE_JEV_MODEL=jev-1.13
# With no provider, routing falls back to simple keyword matching.

# Voice: 1 (or empty) = Orchy speaks and you can call your agents, 0 = chat only. npm run setup asks.
VOICE_ENABLED=

# ElevenLabs: Orchy's voice and the agents' voice calls. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs voice library (default: Rachel).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Deepgram: a backup voice for Orchy's spoken replies. https://console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Dashboard port (http://localhost:8008)
PORT=8008

# Client pages (optional): their own port, put online with a Cloudflare Tunnel + Access
# (README → Client pages). CLIENT_URL is that public address.
CLIENT_PORT=8009
CLIENT_URL=
# Cloudflare Access: Orchy checks the token Cloudflare signs on every visit.
# Your team (your-team or your-team.cloudflareaccess.com) and the Access application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Client video (optional): Cloudflare's terms keep video off a tunnel, so clients' videos and audio play from
# a private Cloudflare R2 bucket through links that last 15 minutes at most. Without these four, clients still see
# their images, PDFs, documents and tables, and a video's poster with "Video playback isn't switched on yet".
# R2_ACCOUNT_ID is the 32-character account id; the token needs Object Read & Write on that one bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Only if a CLI is somewhere Orchy can't find it:
# CLAUDE_CLI_PATH=
# CODEX_CLI_PATH=
# OPENCODE_CLI_PATH=
# HERMES_CLI_PATH=
# DSH_CLI_PATH=
# ONE_CLI_PATH=
# ffmpeg (optional: thumbnails, video posters and playable copies in the file viewer). The ffmpeg binary or its folder.
# FFMPEG_PATH=
# Where the One CLI keeps its sign-ins (default: your home folder)
# ONE_HOME=

# For a second, test copy of Orchy on the same PC:
# NO_OPEN=1        don't open the browser on start
# NO_SCHEDULER=1   don't start scheduled runs (the main copy does)
